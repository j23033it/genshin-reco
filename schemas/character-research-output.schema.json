    "ResearchClaim": {
      "additionalProperties": false,
      "properties": {
        "claimType": {
          "$ref": "#/$defs/EvidenceClaimType"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/BuildCondition"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/ResearchEvidence"
        },
        "normalizedValue": {
          "$ref": "#/$defs/NormalizedClaimValue"
        }
      },
      "required": [
        "claimType",
        "conditions",
        "evidence",
        "normalizedValue"
      ],
      "type": "object"
    },
    "ResearchEvidence": {
      "additionalProperties": false,
      "description": "Codexから受け取る根拠。host由来のsourcePageId等を意図的に含めない。",
      "properties": {
        "evidenceExcerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceSummary": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidenceExcerpt",
        "evidenceSummary",
        "locator",
        "sourceUrl"
      ],
      "type": "object"
    },
    "ResearchLocator": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFragment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "heading",
        "section",
        "textFragment"
      ],
      "type": "object"
    },
    "ResearchSchemaVersion": {
      "enum": [
        "character-research-v1"
      ],
      "type": "string"
    },
    "ResearchSourcePage": {
      "additionalProperties": false,
      "description": "Codexから受け取る未信頼な参照ページ。ID・検証結果・hashはRust側で付与する。",
      "properties": {
        "gameVersion": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "publisher": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "sourceUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "gameVersion",
        "publisher",
        "sourceUrl",
        "title",
        "updatedAt"
      ],
      "type": "object"
    },
    "StatPriority": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "stat": {
          "type": "string"
        }
      },
      "required": [
        "rank",
        "stat"
      ],
      "type": "object"
    },
    "StatUnit": {
      "enum": [
        "flat",
        "percent"
      ],
      "type": "string"
    },
    "SurvivabilityPriority": {
      "enum": [
        "normal",
        "high"
      ],
      "type": "string"
    },
    "TargetScope": {
      "enum": [
        "character_sheet_unbuffed",
        "character_sheet_with_static_team_effects",
        "in_combat_conditional"
      ],
      "type": "string"
    },
    "TargetStatBonus": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "condition",
        "source"
      ],
      "type": "object"
    },
