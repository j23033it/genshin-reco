      "additionalProperties": false,
      "properties": {
        "includedBonuses": {
          "items": {
            "$ref": "#/$defs/TargetStatBonus"
          },
          "maxItems": 16,
          "type": "array"
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/TargetScope"
        },
        "stat": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/StatUnit"
        }
      },
      "required": [
        "includedBonuses",
        "maximum",
        "minimum",
        "note",
        "scope",
        "stat",
        "unit"
      ],
      "type": "object"
    }
