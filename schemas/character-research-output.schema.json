  "additionalProperties": false,
  "description": "1キャラクター分のCodex構造化出力契約。",
  "properties": {
    "characterId": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "#/$defs/ResearchSchemaVersion"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ResearchSourcePage"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/ResearchBuildVariant"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    }
  },
  "required": [
    "characterId",
    "schemaVersion",
    "sources",
    "variants",
    "warnings"
  ],
  "type": "object"
}
