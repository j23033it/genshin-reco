{
  "$defs": {
    "ArtifactHalf": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "exact_set"
              ],
              "type": "string"
            },
            "setId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "setId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "effectGroupId": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "effect_group"
              ],
              "type": "string"
            }
          },
          "required": [
            "effectGroupId",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactPlan": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "setId": {
              "type": "string"
            },
            "type": {
              "enum": [
                "four_piece"
              ],
              "type": "string"
            }
          },
          "required": [
            "setId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "first": {
              "$ref": "#/$defs/ArtifactHalf"
            },
            "second": {
              "$ref": "#/$defs/ArtifactHalf"
            },
            "type": {
              "enum": [
                "two_plus_two"
              ],
              "type": "string"
            }
          },
          "required": [
            "first",
            "second",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "BuildCondition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "value": {
          "$ref": "#/$defs/ConditionValue"
        }
      },
      "required": [
        "description",
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "BuildIntent": {
      "enum": [
        "auto",
        "on_field_damage",
        "off_field_damage",
        "reaction_trigger",
        "support",
        "sustain"
      ],
      "type": "string"
    },
    "CharacterBuildIntent": {
      "additionalProperties": false,
      "properties": {
        "energyPriority": {
          "$ref": "#/$defs/EnergyPriority"
        },
        "reactionOwnership": {
          "$ref": "#/$defs/ReactionOwnership"
        },
        "role": {
          "$ref": "#/$defs/BuildIntent"
        },
        "survivabilityPriority": {
          "$ref": "#/$defs/SurvivabilityPriority"
        }
      },
      "required": [
        "energyPriority",
        "reactionOwnership",
        "role",
        "survivabilityPriority"
      ],
      "type": "object"
    },
    "ConditionOperator": {
      "enum": [
        "equals",
        "not_equals",
        "includes",
        "gte",
        "lte"
      ],
      "type": "string"
    },
    "ConditionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "EnergyPriority": {
      "enum": [
        "damage_first",
        "balanced",
        "burst_stability"
      ],
      "type": "string"
    },
    "EvidenceClaimType": {
      "enum": [
        "artifact_plan",
        "main_stat_package",
        "substat_priority",
        "target_stat",
        "role",
        "team_interaction"
      ],
      "type": "string"
    },
    "MainStatPackage": {
      "additionalProperties": false,
      "properties": {
        "circlet": {
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/BuildCondition"
          },
          "maxItems": 16,
          "type": "array"
        },
        "goblet": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "sands": {
          "type": "string"
        },
        "substatPriority": {
          "items": {
            "$ref": "#/$defs/StatPriority"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "targetStats": {
          "items": {
            "$ref": "#/$defs/TargetStatRange"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "circlet",
        "conditions",
        "goblet",
        "id",
        "sands",
        "substatPriority",
        "targetStats"
      ],
      "type": "object"
    },
    "NormalizedClaimValue": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "artifact_plan"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ArtifactPlan"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "main_stat_package"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/MainStatPackage"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "substat_priority"
              ],
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/StatPriority"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "target_stat"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/TargetStatRange"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "role"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/CharacterBuildIntent"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "team_interaction"
              ],
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ReactionOwnership": {
      "enum": [
        "main",
        "partial",
        "none",
        "unknown"
      ],
      "type": "string"
    },
    "ResearchBuildVariant": {
      "additionalProperties": false,
      "properties": {
        "artifactPlan": {
          "$ref": "#/$defs/ArtifactPlan"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ResearchClaim"
          },
          "maxItems": 48,
          "minItems": 3,
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/BuildCondition"
          },
          "maxItems": 16,
          "type": "array"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "mainStatPackage": {
          "$ref": "#/$defs/MainStatPackage"
        },
        "teamBuffKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
